#!/usr/bin/env python3
"""Page a human from an agent or script. Standard library only, so it works when everything else is down.

  page [--sev info|wake] [--title T] [--url U] [--dedupe KEY] [--window SECONDS] [--source NAME] MESSAGE
  page test [--sev info|wake] [--loud]   send a test; a wake test stays quiet unless --loud
  page status                            show backends and recent sends; never prints secrets; exit 1 if none is set up

A message that is only the word status or test needs a separator: page -- status

Severity decides the route. By default wake tries bark, then ntfy, and info goes to ntfy, then bark. A wake rings
through mute and Do Not Disturb on bark only if the config sets bark's max_level to critical. Repeats of a key inside
its window are suppressed (wake 15 minutes, info 1 hour). A failed send is not recorded, so a retry goes out. Past 6
wakes an hour, further wakes go out as info: a looping agent can't keep ringing the phone.

Exit 0 means a backend accepted it or it was suppressed as a repeat, 1 means every backend failed or none is set up,
2 means bad usage. Accepted doesn't mean seen: neither backend reports that the human read it.

Secrets are one file each, by default ~/.config/page/secrets/bark-key and ntfy-topic (mode 0600). A backend without a
file is skipped. If ~/.config/page/secrets/bark-enc-key exists, bark pushes are encrypted with it, and never go out in
plain text while it is there. With require_encryption on, plain-text backends are not used at all.
~/.config/page/config.json is optional; see the README. A bad setting is reported and ignored, and the rest of the file
still applies. A file that isn't valid JSON is ignored whole, so keep secrets at the default paths to stay reachable
through that too. State that can't be used, or a lock held past 15 seconds, is reported and skipped, so that page goes
out without suppression or the cap. $PAGE_CONFIG_DIR and $PAGE_STATE_DIR override the two
directories.
"""
import argparse
import base64
import contextlib
import fcntl
import hashlib
import json
import os
import re
import secrets
import socket
import stat
import string
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

__version__ = "0.2.1+tspencer.1"

MAX_CHARS = 240
TIMEOUT_SECONDS = 10
KEEP_SECONDS = 86400
LOCK_WAIT_SECONDS = 15
SECRET_FIELD = re.compile(
    r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"
    r"|(?i:(?:password|passwd|secret)\s*[=:]\s*\S+)"
    r"|(?i:\bbearer\s+\S+)"
    r"|(?i:(?:token|api[_-]?key)\s*=\s*\S+)"
    # After a colon, "token: expired" is a sentence. A value with a digit or some length is treated as a credential.
    r"|(?i:(?:token|api[_-]?key)\s*:\s*(?=\S*\d|\S{13})\S+)"
)
# A URL path keeps hashes and ids so the link still opens, so only these are masked there.
KNOWN_CREDENTIAL = re.compile(
    r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"
    r"|\bgh[opusr]_[A-Za-z0-9]{20,}"
    r"|\bgithub_pat_[A-Za-z0-9_]{20,}"
    r"|\bglpat-[A-Za-z0-9_\-]{10,}"
    r"|\bsk-[A-Za-z0-9_\-]{20,}"
    r"|\bxox[abprs]-[A-Za-z0-9\-]{10,}"
    r"|\bAIza[A-Za-z0-9_\-]{30,}"
)
LONG_RUN = re.compile(r"[A-Za-z0-9_\-+/=]{24,}")
READABLE_PART = re.compile(r"[A-Z]?[a-z]{1,18}|[A-Z]{1,19}|\d{1,8}|[A-Za-z0-9]{1,7}")
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
DEFAULTS = {
    "routes": {"wake": ["bark", "ntfy"], "info": ["ntfy", "bark"]},
    "windows": {"wake": 900, "info": 3600},
    "wake_cap_per_hour": 6,
    "require_encryption": False,
    "backends": {
        "bark": {
            "server": "https://api.day.app",
            "secret_file": "secrets/bark-key",
            "volume": 5,
            "encrypt_key_file": "secrets/bark-enc-key",
            "max_level": "active",
        },
        "ntfy": {"server": "https://ntfy.sh", "secret_file": "secrets/ntfy-topic"},
    },
}
SEVERITIES = ("wake", "info")
RINGS_THROUGH_MUTE = {"bark"}
ENCRYPTING_BACKENDS = {"bark"}
# Lowest to highest. Only critical rings through mute and Do Not Disturb.
BARK_LEVELS = ("active", "timeSensitive", "critical")
AES_KEY_LENGTHS = (16, 24, 32)
IV_CHARACTERS = string.ascii_letters + string.digits


def config_dir():
    return Path(os.environ.get("PAGE_CONFIG_DIR") or Path.home() / ".config/page")


def state_dir():
    return Path(os.environ.get("PAGE_STATE_DIR") or Path.home() / ".local/state/page")


def is_int(value, minimum):
    return isinstance(value, int) and not isinstance(value, bool) and value >= minimum


def is_safe_server(server):
    try:
        parts = urllib.parse.urlsplit(server)
    except ValueError:
        return False
    return (parts.scheme == "https" and bool(parts.hostname)) or (
        parts.scheme == "http" and parts.hostname in ("localhost", "127.0.0.1", "::1")
    )


def section(raw, name, problems):
    value = raw.get(name, {})
    if isinstance(value, dict):
        return value
    problems.append(f"{name} is not an object")
    return {}


def backend_setting_problem(name, key, value):
    if key not in DEFAULTS["backends"][name]:
        return f"backend {name} has unknown key {key}"
    if key in ("server", "secret_file", "encrypt_key_file") and not (isinstance(value, str) and value):
        return f"bad {name} {key}"
    if key == "server" and not is_safe_server(value):
        return f"{name} server must use https, or http on this machine: the secret is in the URL"
    if key == "volume" and not (is_int(value, 0) and value <= 10):
        return f"bad {name} volume"
    if key == "max_level" and value not in BARK_LEVELS:
        return f"bad {name} max_level, use one of {list(BARK_LEVELS)}"
    return None


def validate(raw):
    """Merges a parsed config over the defaults, returning (config, problems). A bad setting keeps its default and the
    rest still apply, because the setting that says where the secrets are may be fine."""
    config = json.loads(json.dumps(DEFAULTS))
    if not isinstance(raw, dict):
        return config, ["not a JSON object"]
    problems = []
    unknown = set(raw) - set(DEFAULTS)
    if unknown:
        problems.append(f"unknown keys {sorted(unknown)}")
    for sev, route in section(raw, "routes", problems).items():
        usable = isinstance(route, list) and route and all(isinstance(name, str) and name in BACKENDS for name in route)
        if sev in SEVERITIES and usable:
            config["routes"][sev] = route
        else:
            problems.append(f"bad route {sev}")
    for sev, window in section(raw, "windows", problems).items():
        if sev in SEVERITIES and is_int(window, 0):
            config["windows"][sev] = window
        else:
            problems.append(f"bad window {sev}")
    if "wake_cap_per_hour" in raw:
        if is_int(raw["wake_cap_per_hour"], 1):
            config["wake_cap_per_hour"] = raw["wake_cap_per_hour"]
        else:
            problems.append("bad wake_cap_per_hour")
    if "require_encryption" in raw:
        # A value that isn't a boolean is taken as on: a typo here must not let a page out in plain text.
        config["require_encryption"] = raw["require_encryption"] is not False
        if not isinstance(raw["require_encryption"], bool):
            problems.append("bad require_encryption, treated as true")
    for name, settings in section(raw, "backends", problems).items():
        if name not in BACKENDS or not isinstance(settings, dict):
            problems.append(f"bad backend {name}")
            continue
        for key, value in settings.items():
            problem = backend_setting_problem(name, key, value)
            if problem:
                problems.append(problem)
            else:
                config["backends"][name][key] = value
        # Naming a key file, even a bad name, asks for encryption, so a missing file must not mean plain text.
        if name == "bark" and "encrypt_key_file" in settings:
            config["_encryption_requested"] = True
    return config, problems


def load_config():
    """Returns (config, problem). A missing file is normal; a bad setting falls back to its default."""
    path = config_dir() / "config.json"
    try:
        config, problems = validate(json.loads(path.read_text()))
        return config, f"{path} partly ignored: {'; '.join(problems)}" if problems else None
    except FileNotFoundError:
        return json.loads(json.dumps(DEFAULTS)), None
    except Exception as error:  # Whatever is wrong with the file, the page still has to go out.
        return json.loads(json.dumps(DEFAULTS)), f"{path} ignored: {error}"


def secret(config, name):
    path = Path(config["backends"][name]["secret_file"]).expanduser()
    try:
        return (config_dir() / path).read_text().strip() or None
    except (OSError, ValueError):
        return None


class EncryptionProblem(Exception):
    """Its text names the problem and never holds the key, so it is safe to print."""


def encryption_requested(config):
    return config["require_encryption"] or config.get("_encryption_requested", False)


def encryption_key(config):
    """Returns (key bytes or None, warning or None). None means encryption isn't set up: the default key file is absent
    and nothing asked for it, so bark is plain. Raises EncryptionProblem when bark must not send in plain text: the key
    can't be used, a key file was named or required but is missing, or the key file is a dangling symlink."""
    path = config_dir() / Path(config["backends"]["bark"]["encrypt_key_file"]).expanduser()
    try:
        mode = path.stat().st_mode
        text = path.read_text()
    except FileNotFoundError:
        if path.is_symlink():
            raise EncryptionProblem("encryption key unusable: the key file is a broken link") from None
        if encryption_requested(config):
            raise EncryptionProblem("encryption key unusable: asked for, but the key file is missing") from None
        return None, None
    except (OSError, ValueError) as error:
        raise EncryptionProblem(f"encryption key unusable: {type(error).__name__}") from None
    # The Bark app uses the key's characters as the key bytes, so only printable ASCII keeps lengths equal.
    key = text.rstrip("\r\n")
    if len(key) not in AES_KEY_LENGTHS or not all("!" <= character <= "~" for character in key):
        lengths = "/".join(map(str, AES_KEY_LENGTHS))
        raise EncryptionProblem(f"encryption key unusable: needs {lengths} printable characters")
    warning = "encryption key file is readable by other users" if stat.S_IMODE(mode) & 0o077 else None
    return key.encode(), warning


def _xtime(value):
    value <<= 1
    return (value ^ 0x11B) if value & 0x100 else value


def _make_sbox():
    sbox = [0x63] * 256
    p = q = 1
    while True:
        p = (p ^ _xtime(p)) & 0xFF
        q ^= q << 1
        q ^= q << 2
        q ^= q << 4
        q &= 0xFF
        if q & 0x80:
            q ^= 0x09
        rotated = q
        for shift in (1, 2, 3, 4):
            rotated ^= ((q << shift) | (q >> (8 - shift))) & 0xFF
        sbox[p] = rotated ^ 0x63
        if p == 1:
            return sbox


SBOX = _make_sbox()


def _round_keys(key):
    words_in_key = len(key) // 4
    rounds = words_in_key + 6
    words = [list(key[4 * i:4 * i + 4]) for i in range(words_in_key)]
    rcon = 1
    for i in range(words_in_key, 4 * (rounds + 1)):
        word = list(words[i - 1])
        if i % words_in_key == 0:
            word = [SBOX[b] for b in word[1:] + word[:1]]
            word[0] ^= rcon
            rcon = _xtime(rcon)
        elif words_in_key > 6 and i % words_in_key == 4:
            word = [SBOX[b] for b in word]
        words.append([a ^ b for a, b in zip(words[i - words_in_key], word)])
    return [sum(words[4 * r:4 * r + 4], []) for r in range(rounds + 1)]


def _encrypt_block(round_keys, block):
    state = [b ^ k for b, k in zip(block, round_keys[0])]
    last = len(round_keys) - 1
    for number in range(1, last + 1):
        state = [SBOX[b] for b in state]
        state = [state[(i + 4 * (i % 4)) % 16] for i in range(16)]
        if number != last:
            for c in range(0, 16, 4):
                column = state[c:c + 4]
                total = column[0] ^ column[1] ^ column[2] ^ column[3]
                state[c:c + 4] = [column[j] ^ total ^ _xtime(column[j] ^ column[(j + 1) % 4]) for j in range(4)]
        state = [b ^ k for b, k in zip(state, round_keys[number])]
    return state


def aes_cbc_encrypt(key, iv, data):
    """AES-CBC with PKCS7 padding, as the Bark app decrypts it. Encrypt only: page never needs to decrypt."""
    round_keys = _round_keys(key)
    padding = 16 - len(data) % 16
    data = data + bytes([padding]) * padding
    previous = list(iv)
    out = bytearray()
    for start in range(0, len(data), 16):
        previous = _encrypt_block(round_keys, [a ^ b for a, b in zip(data[start:start + 16], previous)])
        out.extend(previous)
    return bytes(out)


def post(url, data, headers):
    request = urllib.request.Request(url, data=data, headers=headers, method="POST")
    with OPENER.open(request, timeout=TIMEOUT_SECONDS) as response:
        response.read()


def send_bark(config, message, loud):
    """Returns True if max_level kept a loud page from ringing."""
    settings = config["backends"]["bark"]
    key, warning = encryption_key(config)
    if warning:
        print(f"page: bark {warning}", file=sys.stderr)
    wanted = BARK_LEVELS.index("critical" if loud else "active")
    level = BARK_LEVELS[min(wanted, BARK_LEVELS.index(settings["max_level"]))]
    body = {"title": message["title"], "body": message["text"], "group": "page-" + message["sev"], "level": level}
    if level == "critical":
        body.update(volume=settings["volume"], call="1")
    if message["url"]:
        body["url"] = message["url"]
    server = settings["server"].rstrip("/")
    headers = {"Content-Type": "application/json"}
    if key is None:
        post(f"{server}/{secret(config, 'bark')}", json.dumps(body).encode(), headers)
    else:
        # The device key goes in the body, not the path, so it stays out of URL logs. Everything else is inside the
        # ciphertext; the IV is new for each push.
        iv = "".join(secrets.choice(IV_CHARACTERS) for _ in range(16))
        try:
            ciphertext = base64.b64encode(aes_cbc_encrypt(key, iv.encode(), json.dumps(body).encode())).decode()
        except Exception:
            raise EncryptionProblem("encryption failed") from None
        payload = {"device_key": secret(config, "bark"), "ciphertext": ciphertext, "iv": iv}
        post(f"{server}/push", json.dumps(payload).encode(), headers)
    return loud and level != "critical"


def send_ntfy(config, message, loud):
    settings = config["backends"]["ntfy"]
    headers = {"Title": message["title"].encode("ascii", "replace").decode(), "Priority": "5" if loud else "3"}
    if message["url"]:
        headers["Click"] = message["url"]
    post(f"{settings['server'].rstrip('/')}/{secret(config, 'ntfy')}", message["text"].encode(), headers)
    return False


BACKENDS = {"bark": send_bark, "ntfy": send_ntfy}


def failure_reason(error):
    """Names the failure without the error's text, which can contain a URL holding the secret."""
    if isinstance(error, urllib.error.HTTPError):
        return f"http {error.code}"
    if isinstance(error, EncryptionProblem):
        return str(error)
    return type(error).__name__


def deliver(config, message, loud):
    """Tries each set-up backend on the route in order. Returns (backend or None, failure reasons, level capped)."""
    failures = []
    for name in config["routes"][message["sev"]]:
        if not secret(config, name):
            continue
        if config["require_encryption"] and name not in ENCRYPTING_BACKENDS:
            failures.append(f"{name}: blocked, require_encryption is on")
            continue
        try:
            capped = BACKENDS[name](config, message, loud)
            return name, failures, capped
        except Exception as error:  # Any failure, such as a truncated response, moves on to the next backend.
            failures.append(f"{name}: {failure_reason(error)}")
    return None, failures, False


def is_entry(entry):
    return (
        isinstance(entry, dict)
        and isinstance(entry.get("at"), (int, float))
        and all(isinstance(entry.get(field), str) for field in ("key", "sev", "backend"))
    )


def keep_seconds(entry):
    """An entry stays as long as its window needs, so a window past a day still suppresses."""
    window = entry.get("window")
    return max(KEEP_SECONDS, window) if isinstance(window, int) else KEEP_SECONDS


def read_log():
    try:
        lines = (state_dir() / "sent.jsonl").read_text().splitlines()
    except (OSError, ValueError):
        return []
    now = time.time()
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if is_entry(entry) and now - entry["at"] < keep_seconds(entry):
            entries.append(entry)
    return entries


def write_log(entries):
    path = state_dir() / "sent.jsonl"
    temporary = path.with_suffix(".tmp")
    temporary.write_text("".join(json.dumps(entry) + "\n" for entry in entries))
    temporary.replace(path)


def short_hostname():
    return socket.gethostname().split(".")[0]


def mask_run(match):
    """Masks a long run unless it reads as words joined up, such as a branch name, a path or a query like card=some-name.
    This machine's own name always stays, so a page can say where it came from."""
    run = match.group()
    if run == short_hostname():
        return run
    readable = "+" not in run and all(READABLE_PART.fullmatch(part) for part in re.split(r"[-_/=]", run) if part)
    return run if readable else "[masked]"


def mask(text):
    return LONG_RUN.sub(mask_run, SECRET_FIELD.sub("[masked]", text))


def clean(text):
    """Keeps a message short and masks anything shaped like a token. The text goes through third-party servers."""
    return mask(" ".join(text.split()))[:MAX_CHARS]


def clean_url(url):
    """Drops any login and masks tokens in the query and fragment. The path loses only known credential shapes, so the
    link still opens."""
    try:
        parts = urllib.parse.urlsplit(url.strip())
    except ValueError:
        return None
    query, fragment = mask(parts.query), mask(parts.fragment)
    path = KNOWN_CREDENTIAL.sub("[masked]", SECRET_FIELD.sub("[masked]", parts.path))
    cleaned = urllib.parse.urlunsplit((parts.scheme, parts.netloc.rpartition("@")[2], path, query, fragment))
    return urllib.parse.quote(cleaned, safe="%/:=&?~#+!$,;'@()*[]")


def open_lock():
    """Returns the held lock, or None if it can't be had soon. An unrecorded page beats one lost to bad state or a hang."""
    try:
        state_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = open(state_dir() / "lock", "w")
    except OSError:
        return None
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.monotonic() >= deadline:
                lock.close()
                return None
            time.sleep(0.1)


def run_page(sev, text, title, url, dedupe, window, source, loud=None):
    config, problem = load_config()
    if problem:
        print(f"page: {problem}", file=sys.stderr)
    host = short_hostname()
    message = {
        "sev": sev,
        "text": clean(text),
        "title": clean(title or f"{sev}: {source or host}"),
        "url": clean_url(url) if url else None,
    }
    if not message["text"]:
        print("page: empty message", file=sys.stderr)
        return 2
    key = hashlib.sha256((dedupe or f"{message['title']}|{message['text']}").encode()).hexdigest()[:16]
    window = config["windows"][sev] if window is None else window
    cap = config["wake_cap_per_hour"]
    loud = sev == "wake" if loud is None else loud
    capped = False

    lock = open_lock()
    if lock is None:
        print("page: state unavailable, sending without suppression or the wake cap", file=sys.stderr)
    with lock or contextlib.nullcontext():
        entries = read_log() if lock else []
        now = time.time()
        if any(e["key"] == key and e.get("asked") == sev and now - e["at"] < window for e in entries):
            print(f"page: suppressed repeat of {key} (window {window}s)")
            return 0
        if loud and sum(bool(e.get("rang")) and now - e["at"] < 3600 for e in entries) >= cap:
            print(f"page: over {cap} wakes an hour, sending as info", file=sys.stderr)
            capped = True
            message["sev"] = "info"
            message["title"] = clean("wake cap: " + message["title"])
            loud = False
        backend, failures, level_capped = deliver(config, message, loud)
        for failure in failures:
            print(f"page: {failure}", file=sys.stderr)
        if backend is None:
            print("page: not sent, " + ("every backend failed" if failures else "no backend set up"), file=sys.stderr)
            return 1
        if lock:
            entries.append(
                {"at": now, "key": key, "name": clean(dedupe) if dedupe else None, "window": window, "asked": sev,
                 "sev": message["sev"], "rang": loud and not level_capped, "backend": backend, "source": source}
            )
            try:
                write_log(entries)
            except OSError as error:
                print(f"page: sent but not recorded: {type(error).__name__}", file=sys.stderr)
    note = ""
    if capped:
        note = ", capped, did not ring"
    elif level_capped:
        note = ", level capped, did not ring"
    elif message["sev"] == "wake" and not loud:
        note = ", quiet"
    elif loud and backend not in RINGS_THROUGH_MUTE:
        note = ", may not have rung"
    print(f"page: sent sev={message['sev']} via {backend}{note}")
    return 0


def run_status():
    config, problem = load_config()
    if problem:
        print(f"config: {problem}")
    if config["require_encryption"]:
        print("require_encryption: on, plain-text backends are blocked")
    set_up = [name for name in BACKENDS if secret(config, name)]
    for name in BACKENDS:
        line = f"{name}: {'set up' if name in set_up else 'no secret file'}"
        if name == "bark":
            try:
                key, warning = encryption_key(config)
                line += ", encrypted" if key else ", NOT encrypted"
                if warning:
                    line += f", {warning}"
            except EncryptionProblem as problem:
                line += f", {problem}, will not send"
                if name in set_up:
                    set_up.remove(name)
            line += f", max level {config['backends']['bark']['max_level']}"
        elif name in set_up and config["require_encryption"]:
            line += ", blocked by require_encryption"
            set_up.remove(name)
        print(line)
    for entry in read_log()[-10:]:
        when = time.strftime("%m-%dT%H:%M:%SZ", time.gmtime(entry["at"]))
        source = f" source={entry['source']}" if entry.get("source") else ""
        print(f"{when} {entry['sev']} via {entry['backend']} key={entry.get('name') or entry['key']}{source}")
    routed = {name for route in config["routes"].values() for name in route}
    return 0 if routed.intersection(set_up) else 1


def main(argv):
    if argv[:1] == ["status"]:
        argparse.ArgumentParser(prog="page status").parse_args(argv[1:])
        return run_status()
    if argv[:1] == ["test"]:
        parser = argparse.ArgumentParser(prog="page test")
        parser.add_argument("--sev", choices=["info", "wake"], default="info")
        parser.add_argument("--loud", action="store_true", help="really ring: a wake test is quiet without this")
        args = parser.parse_args(argv[1:])
        return run_page(
            args.sev, f"page test from {short_hostname()}", "Page test", None, None, 0, "test",
            loud=args.loud,
        )
    parser = argparse.ArgumentParser(prog="page", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--sev", choices=["info", "wake"], default="info")
    parser.add_argument("--title")
    parser.add_argument("--url", help="opened when the notification is tapped, such as a ticket or dashboard")
    parser.add_argument("--dedupe", help="repeats of this key inside the window are suppressed")
    parser.add_argument("--window", type=int, help="seconds; defaults to the configured window for the severity")
    parser.add_argument("--source", help="who is paging, shown in the default title")
    parser.add_argument("message")
    args = parser.parse_args(argv)
    return run_page(args.sev, args.message, args.title, args.url, args.dedupe, args.window, args.source)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
